# Copie para .env para mudar os padrões de desenvolvimento.
# O docker compose lê o .env sozinho; o backend lê variáveis de ambiente do sistema.

DB_NAME=financetable
DB_USERNAME=financetable
DB_PASSWORD=troque-esta-senha
DB_PORT=5432

# Backend
DB_URL=jdbc:postgresql://localhost:5432/financetable
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="FinanceTable <nao-responda@financetable.local>"
FRONTEND_URL=http://localhost:4200
COOKIE_SECURE=false
